
# Host-side port the relay is reachable on (maps to the container's fixed 8000).
# 8000 is shown below; change to whatever your nginx / certbot expects.
VPS_PORT=8000

# SQLite database path inside the container. Default is a dedicated volume mount
# location; override this if you want the DB elsewhere.
DB_PATH=/app/data/vela.db

# Container listen host (informational — uvicorn binds 0.0.0.0 inside the image).
VPS_HOST=0.0.0.0

# Firebase Admin service-account JSON for FCM push delivery.
# Place your key at ./secrets/firebase-adminsdk.json (chmod 600) and reference
# it here. Must be a service-account key ("type": "service_account"), NOT
# google-services.json. Leave empty to skip FCM (push notifications disabled).
VELAVPS_FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-adminsdk.json

# --- Optional overrides (defaults ship in config.yaml) ----------------------
# Uncomment / adjust any of the below to deviate from the bundled defaults.

# VPS_RATE_LIMIT=100/minute
# VPS_ALLOW_DIRECT_AGENT_FORWARDING=true
# VPS_LEGACY_REGISTRATION_ENABLED=true
# VPS_DEFAULT_AGENT_TIMEOUT_SECONDS=20
# VPS_AGENT_CONNECT_WAIT_SECONDS=8
# VPS_PAIRING_CODE_TTL_SECONDS=600
# VPS_ACTIVATION_TOKEN_TTL_SECONDS=180
# VPS_CONNECTIVITY_OFFLINE_DELAY_SECONDS=30
# VPS_TRUSTED_PROXY_IPS=172.17.0.1
